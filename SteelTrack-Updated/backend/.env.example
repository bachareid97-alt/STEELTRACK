# Example environment variables for production. Do NOT commit secrets to git.
# Copy this file to .env and fill values on the host before starting.

# App
ADMIN_USER=admin
# ADMIN_PASS should be set on the host (do not commit)
# JWT_SECRET should be a long random value and set on the host
# DATABASE_URL must point to your Postgres instance
# Example: postgresql://postgres:strongpassword@db:5432/steeltrack
DATABASE_URL=postgresql://postgres:postgres@db:5432/steeltrack

# Postgres
POSTGRES_USER=postgres
# POSTGRES_PASSWORD should be set on the host
POSTGRES_DB=steeltrack
