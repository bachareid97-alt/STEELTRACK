[Unit]
Description=SteelTrack (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/steeltrack/backend
ExecStart=/usr/local/bin/docker compose -f /opt/steeltrack/backend/docker-compose.prod.yml up -d
ExecStop=/usr/local/bin/docker compose -f /opt/steeltrack/backend/docker-compose.prod.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
